# Copier ce fichier en .env et remplir les valeurs

PORT=3000

# Mot de passe de l'espace admin Emma (/emma)
# OBLIGATOIRE : changez-le avant la mise en production !
# Sur Vercel, définissez cette variable dans Settings → Environment Variables.
ADMIN_PASSWORD=changez-moi-en-production

# Origines autorisées pour CORS (séparées par virgule)
# En local, laisser vide pour autoriser localhost automatiquement.
ALLOWED_ORIGINS=https://ordutemps.fr,https://www.ordutemps.fr

# URL Calendly d'Emma (pour le bouton de réservation), si utilisée
CALENDLY_URL=https://calendly.com/emma-garcia

# Vercel Blob — stockage des photos/vidéos et de la config.
# En PRODUCTION : injecté automatiquement quand un store Blob est lié au projet
#                 (Dashboard Vercel → Storage → Blob).
# EN LOCAL      : récupérez-le avec `vercel env pull .env`.
# S'il est absent, l'app utilise le système de fichiers local (dossier data/).
BLOB_READ_WRITE_TOKEN=

# Le formulaire de contact utilise Formspree (configuré dans l'espace admin,
# champ « Formspree ID »). Aucune variable SMTP n'est nécessaire.
