# Copier ce fichier en .env et remplir les valeurs

PORT=3000

# SMTP (ex : Gmail, OVH, Infomaniak...)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
EMAIL_USER=votre-adresse@example.com
EMAIL_PASS=votre-mot-de-passe

# Email qui reçoit les messages du formulaire
EMAIL_TO=contact@ordutemps.fr

# URL Calendly d'Emma (pour le bouton de réservation)
CALENDLY_URL=https://calendly.com/emma-garcia

# Mot de passe de l'espace admin Emma
# OBLIGATOIRE : changez-le avant de démarrer en production !
ADMIN_PASSWORD=changez-moi-en-production

# Origines autorisées pour CORS (séparées par virgule)
# En local, laisser vide pour autoriser localhost automatiquement
ALLOWED_ORIGINS=https://ordutemps.fr,https://www.ordutemps.fr
